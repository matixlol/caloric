{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": false,
    "types": ["@cloudflare/workers-types", "bun"]
  },
  "include": ["alchemy.run.ts", "drizzle.config.ts", "src", "test"]
}
