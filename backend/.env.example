PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mfp_proxy
# Better Auth — required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret
# Public URL the app reaches this backend at (used for cookies + OTP links).
BETTER_AUTH_URL=http://localhost:8787
# Optional: extra trusted deep-link/web origins (comma-separated). The caloric://
# and caloric-dev:// app schemes are always trusted.
AUTH_TRUSTED_ORIGINS=
# Optional: browser origins allowed to call the API with credentials (web build).
WEB_ORIGINS=
# Optional: Resend transactional email for delivering login codes. Without these,
# login codes are written to the server logs instead of emailed.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Caloric <login@caloric.mati.lol>
SEARCH_CACHE_TTL_DAYS=30
MFP_GUEST_ACCESS_TOKEN=
MFP_USERNAME=your_email@example.com
MFP_PASSWORD=your_password_here
MFP_PROXY_URL=http://username:password@proxy.example.com:1080
MFP_BROWSER_HEADLESS=true
TWO_CAPTCHA_API_KEY=your_2captcha_api_key
GOOGLE_AI_STUDIO_API_KEY=***
MFP_DETAIL_CONCURRENCY=10
MFP_REQUEST_TIMEOUT_MS=20000
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.net
OPEN_FOOD_FACTS_USER_AGENT=Caloric/1.0 (OpenFoodFacts integration; set a real contact)
OPEN_FOOD_FACTS_USER_EMAIL=your_email@example.com
GEMINI_MODEL=gemini-3-flash-preview
