PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mfp_proxy
SEARCH_CACHE_TTL_DAYS=30
MFP_USERNAME=your_email@example.com
MFP_PASSWORD=your_password_here
MFP_PROXY_URL=http://username:password@proxy.example.com:1080
MFP_BROWSER_HEADLESS=true
TWO_CAPTCHA_API_KEY=your_2captcha_api_key
OPENROUTER_API_KEY=***
MFP_DETAIL_CONCURRENCY=10
MFP_REQUEST_TIMEOUT_MS=20000
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.net
OPEN_FOOD_FACTS_USER_AGENT=Caloric/1.0 (OpenFoodFacts integration; set a real contact)
OPEN_FOOD_FACTS_USER_EMAIL=your_email@example.com
OPENROUTER_MODEL=google/gemini-3-flash-preview
# Optional: pin a provider slug like google-ai-studio or google-vertex. Leave unset to let OpenRouter choose, sorted by throughput.
OPENROUTER_PROVIDER_ONLY=
