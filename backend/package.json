{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --import ./src/instrument.ts src/server.ts",
    "start": "bun --import ./src/instrument.ts src/server.ts",
    "mfp:install-browser": "node -e \"const { execFileSync } = require('node:child_process'); const path = require('node:path'); const packageJson = require.resolve('rebrowser-playwright/package.json'); execFileSync(process.execPath, [path.join(path.dirname(packageJson), 'cli.js'), 'install', 'chromium', ...process.argv.slice(1)], { stdio: 'inherit' });\" --",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "anmat:import-product-html": "bun src/providers/anmat/import-product-html.ts",
    "anmat:import-product-derived": "bun src/providers/anmat/import-product-derived.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.67",
    "@caloric/data-model": "workspace:*",
    "@clerk/backend": "^2.14.20",
    "@foxglove/wasm-zstd": "^1.0.1",
    "@hono/otel": "^1.1.1",
    "@sentry/bun": "^10.47.0",
    "ai": "^6.0.168",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.44.5",
    "eventsource-parser": "^3.0.6",
    "hono": "^4.12.14",
    "playwright": "1.52.0",
    "playwright-core": "1.52.0",
    "postgres": "^3.4.7",
    "rebrowser-playwright": "1.52.0",
    "typeid-js": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
