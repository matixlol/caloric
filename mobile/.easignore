# EAS regenerates native deps/builds during the build, so exclude them from the
# uploaded archive. NOTE: when this file exists, EAS uses it INSTEAD of .gitignore,
# so it must also cover what .gitignore excludes.

# --- from .gitignore ---
expo-env.d.ts
.env.local

# --- heavy generated output (regenerated on the build server) ---
node_modules/

# Native projects are generated output (CNG). Exclude them entirely so EAS runs
# a clean `expo prebuild` in the cloud instead of building our locally-generated
# ios/ (which leaks machine-specific paths like NODE_BINARY/hermesc into the
# build and breaks the JS bundle step).
/ios
/android

# Local Expo precompiled-framework cache (large, regenerated on the server).
packages/precompile/.build/

# Android build artifacts
android/build/
android/app/build/
android/.gradle/
android/.cxx/

# Expo / Metro caches
.expo/
.expo-shared/
web-build/
dist/

# Misc
*.log
.DS_Store
